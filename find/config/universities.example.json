{
    "repositoryConcurrency": 4,
    "databaseBatchSize": 100,
    "classification": {
        "provider": "ollama-openai-compatible",
        "baseUrl": "http://127.0.0.1:11434/v1",
        "model": "granite4.2-8b-12k",
        "apiKeyEnv": "OLLAMA_API_KEY",
        "threshold": 0.4,
        "concurrency": 1,
        "timeoutMs": 300000,
        "maxRetries": 1,
        "promptVersion": "v3",
        "affiliationEvidenceGate": "names_institution",
        "citationMode": "evidence_id",
        "generation": {
            "responseFormat": "json_schema",
            "temperature": 0,
            "maxOutputTokens": 512,
            "maxOutputTokensField": "max_tokens",
            "reasoningEffort": "none"
        },
        "truncation": {
            "mode": "start_end",
            "maxChars": 12000,
            "startChars": 9000,
            "endChars": 3000
        }
    },
    "universities": [
        {
            "key": "Saint Louis University",
            "fullName": "Saint Louis University",
            "acronym": "SLU",
            "excludedNames": ["Saint Louis University Baguio"],
            "emailDomains": ["slu.edu"],
            "additionalQueries": []
        }
    ]
}
